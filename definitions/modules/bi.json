{
 "id": "bi",
 "name": "Báo cáo & phân tích",
 "description": "Dashboard, báo cáo, KPI. Khung để đọc dữ liệu chéo mọi module.",
 "category": "platform",
 "version": "0.2.0",
 "depends": ["communication"],
 "core": false,
 "entities": [
  {
   "name": "dashboard",
   "label": "Dashboard",
   "fields": [
    {
     "name": "name",
     "type": "string",
     "required": true
    },
    {
     "name": "widgets",
     "type": "json",
     "required": false
    }
   ],
   "states": null,
   "computed": {},
   "constraints": []
  },
  {
   "name": "report",
   "label": "Báo cáo",
   "fields": [
    {
     "name": "name",
     "type": "string",
     "required": true
    },
    {
     "name": "query",
     "type": "json",
     "required": false
    },
    {
     "name": "email_recipients",
     "type": "json",
     "required": false
    },
    {
     "name": "schedule",
     "type": "enum",
     "required": false,
     "options": ["daily", "weekly"]
    },
    {
     "name": "schedule_status",
     "type": "enum",
     "required": false,
     "system": true,
     "options": ["paused", "scheduled"]
    },
    {
     "name": "schedule_owner",
     "type": "string",
     "required": false,
     "system": true
    },
    {
     "name": "next_run_at",
     "type": "datetime",
     "required": false,
     "system": true
    }
   ],
   "states": {
    "field": "schedule_status",
    "initial": "paused",
    "actions": {
     "scheduled": { "from": ["paused"], "to": "scheduled" },
     "paused": { "from": ["scheduled"], "to": "paused" },
     "run_due": { "from": ["scheduled"], "to": "scheduled" }
    }
   },
   "computed": {},
   "constraints": []
  },
  {
   "name": "report_run",
   "label": "Lần chạy báo cáo",
   "systemManaged": true,
   "fields": [
    { "name": "report", "type": "ref", "required": true, "ref": "bi.report", "system": true },
    { "name": "run_at", "type": "datetime", "required": true, "system": true },
    { "name": "row_count", "type": "number", "required": true, "system": true },
    { "name": "result", "type": "json", "required": true, "system": true },
    { "name": "status", "type": "enum", "required": true, "system": true, "options": ["completed"] }
   ],
   "states": null,
   "computed": {},
   "constraints": []
  },
  {
   "name": "kpi",
   "label": "Chỉ tiêu KPI",
   "fields": [
    {
     "name": "name",
     "type": "string",
     "required": true
    },
    {
     "name": "report",
     "type": "ref",
     "required": false,
     "ref": "bi.report"
    },
    {
     "name": "formula",
     "type": "string",
     "required": false
    },
    {
     "name": "target",
     "type": "number",
     "required": false
    }
   ],
   "states": null,
   "computed": {},
   "constraints": []
  }
 ],
 "rules": [],
 "seeds": [],
 "publishes": ["bi.report.run_due", "bi.report.paused", "bi.report.scheduled"],
 "jobs": []
}
