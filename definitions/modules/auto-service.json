     "required": true,
     "ref": "master-data.party"
    },
    {
     "name": "plate",
     "type": "string",
     "required": true
    },
    {
     "name": "make",
     "type": "string",
     "required": false
    },
    {
     "name": "model",
     "type": "string",
     "required": false
    },
    {
     "name": "vin",
     "type": "string",
     "required": false
    },
    {
     "name": "odometer",
     "type": "number",
     "required": false
    }
   ],
   "states": null,
   "computed": {},
   "constraints": []
  },
  {
   "name": "repair_order",
   "label": "Lệnh sửa chữa",
   "fields": [
    {
     "name": "vehicle",
     "type": "ref",
     "required": true,
     "ref": "auto-service.vehicle"
    },
    {
     "name": "party",
     "type": "ref",
     "required": true,
     "ref": "master-data.party"
    },
    {
     "name": "warehouse",
     "type": "ref",
     "required": false,
     "ref": "inventory.warehouse"
    },
    {
     "name": "complaint",
     "type": "text",
     "required": false
    },
    {
     "name": "lines",
     "type": "json",
     "required": false
    },
    {
     "name": "total",
     "type": "money",
     "required": false,
     "system": true
    },
    {
     "name": "status",
     "type": "enum",
     "required": false,
     "options": [
      "intake",
      "approved",
      "in_progress",
      "completed",
      "delivered"
     ]
    }
   ],
   "states": {
    "field": "status",
    "initial": "intake",
    "actions": {
     "approved": {
      "from": [
       "intake"
      ],
      "to": "approved"
     },
     "started": {
      "from": [
       "approved"
      ],
      "to": "in_progress"
     },
     "completed": {
      "from": [
       "in_progress"
      ],
      "to": "completed"
     },
     "delivered": {
      "from": [
       "completed"
      ],
      "to": "delivered"
     }
    }
   },
   "computed": {},
   "constraints": []
  }
 ],
