{
 "id": "restaurant",
 "name": "Nhà hàng / F&B",
 "description": "Bàn, đặt chỗ, thực đơn, công thức, order tại bàn, màn hình bếp. Gửi bếp tự tạo phiếu bếp; thanh toán tự trừ kho và ghi thu.",
 "category": "industry",
 "version": "0.2.0",
 "depends": [
  "master-data",
  "inventory",
  "accounting"
 ],
 "core": false,
 "entities": [
  {
   "name": "table",
   "label": "Bàn",
   "fields": [
    {
     "name": "name",
     "type": "string",
     "required": true
    },
    {
     "name": "seats",
     "type": "number",
     "required": false
    },
    {
     "name": "branch",
     "type": "ref",
     "required": false,
     "ref": "master-data.branch"
    }
   ],
   "states": null,
   "computed": {},
   "constraints": []
  },
  {
   "name": "menu_item",
   "label": "Món",
   "fields": [
    {
     "name": "product",
     "type": "ref",
     "required": true,
     "ref": "master-data.product"
    },
    {
     "name": "station",
     "type": "enum",
     "required": false,
     "options": [
      "kitchen",
      "bar"
     ]
    },
    {
     "name": "available",
     "type": "bool",
     "required": false
    }
   ],
   "states": null,
   "computed": {},
   "constraints": []
  },
  {
   "name": "recipe",
   "label": "Công thức",
   "fields": [
    {
     "name": "product",
     "type": "ref",
     "required": true,
     "ref": "master-data.product"
    },
    {
     "name": "ingredients",
     "type": "json",
     "required": true
    },
    {
     "name": "output_qty",
     "type": "number",
     "required": false
    }
   ],
   "states": null,
   "computed": {},
   "constraints": []
  },
  {
   "name": "table_order",
   "label": "Order bàn",
   "fields": [
    {
     "name": "table",
     "type": "ref",
     "required": false,
     "ref": "restaurant.table"
    },
    {
     "name": "guest_count",
     "label": "Số khách",
     "type": "number",
     "required": false
    },
    {
     "name": "party",
     "type": "ref",
     "required": false,
     "ref": "master-data.party"
    },
    {
     "name": "warehouse",
     "type": "ref",
     "required": false,
     "ref": "inventory.warehouse"
    },
    {
     "name": "method",
     "type": "enum",
     "required": false,
     "options": [
      "cash",
      "card",
      "transfer",
      "ewallet"
     ]
    },
    {
     "name": "cancellation_reason",
     "label": "Lý do hủy sau khi gửi bếp",
     "type": "text",
     "required": false
    },
    {
     "name": "lines",
     "type": "json",
     "required": false
    },
    {
     "name": "total",
     "type": "money",
     "required": false,
     "system": true
    },
    {
     "name": "tax_total",
     "type": "money",
     "required": false,
     "system": true
    },
    {
     "name": "consumptions",
     "type": "json",
     "required": false,
     "system": true
    },
    {
     "name": "status",
     "type": "enum",
     "required": false,
     "options": [
      "open",
      "sent",
      "served",
      "completed",
      "cancelled"
     ]
    }
   ],
   "states": {
    "field": "status",
    "initial": "open",
    "actions": {
     "sent": {
      "from": [
       "open"
      ],
      "to": "sent"
     },
     "served": {
      "from": [
       "sent"
      ],
      "to": "served"
     },
     "completed": {
      "from": [
       "served"
      ],
      "to": "completed"
     },
     "cancelled": {
      "from": [
       "open",
       "sent"
      ],
      "to": "cancelled"
     }
    }
   },
   "computed": {},
   "constraints": []
  },
  {
   "name": "kitchen_ticket",
   "label": "Phiếu bếp",
   "fields": [
    {
     "name": "order",
     "type": "ref",
     "required": true,
     "ref": "restaurant.table_order"
    },
    {
     "name": "station",
     "type": "enum",
     "required": true,
     "options": [
      "kitchen",
      "bar"
     ]
    },
    {
     "name": "lines",
     "type": "json",
     "required": false
    },
    {
     "name": "status",
     "type": "enum",
     "required": false,
     "options": [
      "queued",
      "preparing",
      "ready",
      "cancelled"
     ]
    }
   ],
   "states": {
    "field": "status",
    "initial": "queued",
    "actions": {
     "preparing": {
      "from": [
       "queued"
      ],
      "to": "preparing"
     },
     "ready": {
      "from": [
       "preparing"
      ],
      "to": "ready"
     },
     "cancelled": {
      "from": [
       "queued"
      ],
      "to": "cancelled"
     }
    }
   },
   "computed": {},
   "constraints": []
  },
  {
   "name": "reservation",
   "label": "Đặt bàn",
   "fields": [
    {
     "name": "guest_name",
     "label": "Tên khách",
     "type": "string",
     "required": true
    },
    {
     "name": "phone",
     "label": "Điện thoại",
     "type": "string",
     "required": false
    },
    {
     "name": "table",
     "label": "Bàn",
     "type": "ref",
     "required": false,
     "ref": "restaurant.table"
    },
    {
     "name": "guest_count",
     "label": "Số khách",
     "type": "number",
     "required": true
    },
    {
     "name": "starts_at",
     "label": "Bắt đầu",
     "type": "datetime",
     "required": true
    },
    {
     "name": "ends_at",
     "label": "Kết thúc",
     "type": "datetime",
     "required": true
    },
    {
     "name": "note",
     "label": "Ghi chú",
     "type": "text",
     "required": false
    }
   ],
   "states": {
    "field": "status",
    "initial": "requested",
    "actions": {
     "confirmed": {
      "from": ["requested"],
      "to": "confirmed"
     },
     "arrived": {
      "from": ["confirmed"],
      "to": "arrived"
     },
     "cancelled": {
      "from": ["requested", "confirmed"],
      "to": "cancelled"
     },
     "no_show": {
      "from": ["confirmed"],
      "to": "no_show"
     },
     "completed": {
      "from": ["arrived"],
      "to": "completed"
     }
    }
   },
   "computed": {},
   "constraints": []
  }
 ],
 "rules": [],
 "seeds": [],
 "publishes": [],
 "jobs": []
}
