{
 "id": "manufacturing",
 "name": "Sản xuất",
 "description": "Định mức BOM, lệnh sản xuất theo trung tâm máy và công suất ngày. Bắt đầu lệnh xuất nguyên liệu vào WIP; QC đạt sẽ nhập thành phẩm vào kho. Cho phép sửa hoặc loại bỏ một phần lượng lỗi, tạo phiếu QC riêng cho lượng sửa và hạch toán chi phí loại bỏ từ WIP sang chi phí.",
 "category": "supply",
 "version": "0.5.0",
 "depends": [
  "master-data",
  "inventory",
  "quality",
  "accounting"
 ],
 "core": false,
 "entities": [
  {
   "name": "bom",
   "label": "Định mức (BOM)",
   "fields": [
    {
     "name": "product",
     "type": "ref",
     "required": true,
     "ref": "master-data.product"
    },
    {
     "name": "components",
     "type": "json",
     "required": false
    },
    {
     "name": "output_qty",
     "type": "number",
     "required": false
    }
   ],
   "states": null,
   "computed": {},
   "constraints": []
  },
  {
   "name": "production_order",
   "label": "Lệnh sản xuất",
   "fields": [
    {
     "name": "product",
     "type": "ref",
     "required": true,
     "ref": "master-data.product"
    },
    {
     "name": "qty",
     "type": "number",
     "required": true
    },
    {
     "name": "good_qty",
     "type": "number",
     "required": false
    },
    {
     "name": "scrap_qty",
     "type": "number",
     "required": false
    },
    {
     "name": "scrap_reason",
     "type": "string",
     "required": false
    },
    {
     "name": "scrap_cost_method",
     "type": "enum",
     "required": false,
     "options": [
      "absorb",
      "expense"
     ]
    },
    {
     "name": "scrap_expense_account",
     "type": "ref",
     "required": false,
     "ref": "accounting.account"
    },
    {
     "name": "output_lot_code",
     "type": "string",
     "required": false
    },
    {
     "name": "output_expiry",
     "type": "date",
     "required": false
    },
    {
     "name": "bom",
     "type": "ref",
     "required": true,
     "ref": "manufacturing.bom"
    },
    {
     "name": "warehouse",
     "type": "ref",
     "required": true,
     "ref": "inventory.warehouse"
    },
    {
     "name": "work_center",
     "type": "ref",
     "required": false,
     "ref": "manufacturing.work_center"
    },
    {
     "name": "planned_start",
     "type": "date",
     "required": false
    },
    {
     "name": "status",
     "type": "enum",
     "required": false,
     "options": [
      "planned",
      "in_progress",
      "done",
      "cancelled"
     ]
    }
   ],
   "states": {
    "field": "status",
    "initial": "planned",
    "actions": {
     "started": {
      "from": [
       "planned"
      ],
      "to": "in_progress"
     },
     "done": {
      "from": [
       "in_progress"
      ],
      "to": "done"
     },
     "cancelled": {
      "from": [
       "planned",
       "in_progress"
      ],
      "to": "cancelled"
     }
    }
   },
   "computed": {},
   "constraints": []
  },
  {
   "name": "rework_order",
   "label": "Lệnh sửa hàng lỗi",
   "fields": [
    { "name": "production_order", "type": "ref", "required": true, "ref": "manufacturing.production_order" },
    { "name": "inspection", "type": "ref", "required": true, "ref": "quality.inspection" },
    { "name": "qty", "type": "number", "required": true },
    { "name": "reason", "type": "text", "required": true },
    { "name": "status", "type": "enum", "required": false, "options": ["planned", "in_progress", "done", "cancelled"] }
   ],
   "states": {
    "field": "status",
    "initial": "planned",
    "actions": {
     "started": { "from": ["planned"], "to": "in_progress" },
     "done": { "from": ["in_progress"], "to": "done" },
     "cancelled": { "from": ["planned"], "to": "cancelled" }
    }
   },
   "computed": {},
   "constraints": []
  },
  {
   "name": "production_disposition",
   "label": "Xử lý hàng thành phẩm QC lỗi",
   "fields": [
    { "name": "inspection", "type": "ref", "required": true, "ref": "quality.inspection" },
    { "name": "qty", "type": "number", "required": true },
    { "name": "note", "type": "text", "required": true },
    { "name": "expense_account", "type": "ref", "required": true, "ref": "accounting.account" },
    { "name": "status", "type": "enum", "required": false, "options": ["draft", "posted", "cancelled"] }
   ],
   "states": {
    "field": "status",
    "initial": "draft",
    "actions": {
     "posted": { "from": ["draft"], "to": "posted" },
     "cancelled": { "from": ["draft"], "to": "cancelled" }
    }
   },
   "computed": {},
   "constraints": []
  },
  {
   "name": "work_center",
   "label": "Trung tâm sản xuất",
   "fields": [
    {
     "name": "name",
     "type": "string",
     "required": true
    },
    {
     "name": "capacity_per_day",
     "type": "number",
     "required": false
    }
   ],
   "states": null,
   "computed": {},
   "constraints": []
  }
 ],
 "rules": [],
 "seeds": [],
 "publishes": [],
 "jobs": []
}
