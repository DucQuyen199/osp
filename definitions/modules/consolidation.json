{
  "id": "consolidation",
  "name": "Đa công ty",
  "description": "Nhóm pháp nhân có sự đồng ý chia sẻ và cấu hình tiền tệ báo cáo hợp nhất.",
  "category": "finance",
  "version": "0.1.0",
  "depends": ["accounting", "master-data"],
  "core": false,
  "entities": [
    {
      "name": "company_group",
      "label": "Nhóm công ty",
      "fields": [
        { "name": "name", "type": "string", "required": true },
        { "name": "reporting_currency", "type": "ref", "required": true, "ref": "master-data.currency" },
        { "name": "max_rate_age_days", "type": "number", "required": false },
        { "name": "description", "type": "text", "required": false }
      ],
      "states": null,
      "computed": {},
      "constraints": [
        { "type": "min", "field": "max_rate_age_days", "value": 1, "message": "Maximum currency rate age must be at least one day" }
      ]
    },
    {
      "name": "member",
      "label": "Công ty thành viên",
      "systemManaged": true,
      "fields": [
        { "name": "group", "type": "ref", "required": true, "ref": "consolidation.company_group" },
        { "name": "member_tenant_id", "type": "string", "required": true },
        { "name": "member_name", "type": "string", "required": true },
        { "name": "status", "type": "enum", "required": false, "options": ["invited", "active", "revoked"] },
        { "name": "consented_by", "type": "string", "required": false, "system": true },
        { "name": "consented_at", "type": "string", "required": false, "system": true }
      ],
      "states": {
        "field": "status",
        "initial": "invited",
        "actions": {
          "accepted": { "from": ["invited"], "to": "active" },
          "revoked": { "from": ["invited", "active"], "to": "revoked" }
        }
      },
      "computed": {},
      "constraints": []
    },
    {
      "name": "shared_company",
      "label": "Đơn vị đã chia sẻ",
      "systemManaged": true,
      "fields": [
        { "name": "owner_tenant_id", "type": "string", "required": true },
        { "name": "owner_member_id", "type": "string", "required": true },
        { "name": "owner_name", "type": "string", "required": true },
        { "name": "status", "type": "enum", "required": false, "options": ["active", "revoked"] }
      ],
      "states": {
        "field": "status",
        "initial": "active",
        "actions": {
          "revoked": { "from": ["active"], "to": "revoked" }
        }
      },
      "computed": {},
      "constraints": []
    },
    {
      "name": "report_grant",
      "label": "Quyền xem báo cáo tập đoàn",
      "systemManaged": true,
      "fields": [
        { "name": "group", "type": "ref", "required": true, "ref": "consolidation.company_group" },
        { "name": "user_id", "type": "string", "required": true },
        { "name": "report_type", "type": "enum", "required": true, "options": ["trial_balance"] },
        { "name": "status", "type": "enum", "required": false, "options": ["active", "revoked"] }
      ],
      "states": {
        "field": "status",
        "initial": "active",
        "actions": {
          "revoked": { "from": ["active"], "to": "revoked" }
        }
      },
      "computed": {},
      "constraints": []
    },
    {
      "name": "report_snapshot",
      "label": "Báo cáo hợp nhất đã lưu",
      "systemManaged": true,
      "fields": [
        { "name": "group", "type": "ref", "required": true, "ref": "consolidation.company_group" },
        { "name": "report_type", "type": "enum", "required": true, "options": ["trial_balance"] },
        { "name": "requested_by", "type": "string", "required": true },
        { "name": "from_date", "type": "date", "required": false },
        { "name": "to_date", "type": "date", "required": true },
        { "name": "reporting_currency", "type": "string", "required": true },
        { "name": "snapshot_at", "type": "datetime", "required": true },
        { "name": "payload", "type": "json", "required": true }
      ],
      "states": null,
      "computed": {},
      "constraints": []
    },
    {
      "name": "elimination_journal",
      "label": "Bút toán loại trừ nội bộ",
      "fields": [
        { "name": "group", "type": "ref", "required": true, "ref": "consolidation.company_group" },
        { "name": "posting_date", "type": "date", "required": true },
        { "name": "memo", "type": "text", "required": true },
        { "name": "lines", "type": "json", "required": true },
        { "name": "matching_evidence", "type": "json", "required": true },
        { "name": "status", "type": "enum", "required": false, "options": ["draft", "submitted", "posted", "rejected"] }
      ],
      "states": {
        "field": "status",
        "initial": "draft",
        "actions": {
          "submitted": { "from": ["draft", "rejected"], "to": "submitted" },
          "posted": { "from": ["submitted"], "to": "posted" },
          "rejected": { "from": ["submitted"], "to": "rejected" }
        }
      },
      "computed": {},
      "constraints": []
    }
  ]
}
