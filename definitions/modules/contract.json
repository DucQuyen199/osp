{
 "id": "contract",
 "name": "Hợp đồng",
 "description": "Hợp đồng, điều khoản, phụ lục có phê duyệt và vòng đời hiệu lực/hết hạn.",
 "category": "operations",
 "version": "0.1.0",
 "depends": [
  "master-data"
 ],
 "core": false,
 "entities": [
  {
   "name": "contract",
   "label": "Hợp đồng",
   "fields": [
    {
     "name": "title",
     "type": "string",
     "required": true
    },
    {
      "name": "terms",
      "type": "text",
      "required": false
    },
    {
     "name": "party",
     "type": "ref",
     "required": true,
     "ref": "master-data.party"
    },
    {
     "name": "start_date",
     "type": "date",
     "required": false
    },
    {
     "name": "end_date",
     "type": "date",
     "required": false
    },
    {
     "name": "value",
     "type": "money",
     "required": false
    },
    {
     "name": "source",
     "type": "string",
     "required": false,
     "system": true
    },
    {
     "name": "source_id",
     "type": "string",
     "required": false,
     "system": true
    },
    {
      "name": "amendment_in_progress",
      "type": "string",
      "required": false,
      "system": true
    },
    {
      "name": "last_amendment",
      "type": "string",
      "required": false,
      "system": true
    },
    {
      "name": "amendment_history",
      "type": "json",
      "required": false,
      "system": true
    },
    {
     "name": "status",
     "type": "enum",
     "required": false,
     "options": [
      "draft",
      "active",
      "terminated",
      "expired"
     ]
    }
   ],
   "states": {
    "field": "status",
    "initial": "draft",
    "actions": {
     "activated": {
      "from": [
       "draft"
      ],
      "to": "active"
     },
     "terminated": {
      "from": [
       "active"
      ],
      "to": "terminated"
     },
      "amended": {
        "from": [
          "active"
        ],
        "to": "active"
      },
     "cancelled": {
      "from": [
       "draft"
      ],
      "to": "terminated"
     },
     "expired": {
      "from": [
       "active"
      ],
      "to": "expired"
     }
    }
   },
   "computed": {},
   "constraints": []
  },
  {
   "name": "clause",
   "label": "Điều khoản",
   "fields": [
    {
     "name": "contract",
     "type": "ref",
     "required": true,
     "ref": "contract.contract"
    },
    {
     "name": "title",
     "type": "string",
     "required": true
    },
    {
     "name": "body",
     "type": "text",
     "required": false
    }
   ],
   "states": null,
   "computed": {},
   "constraints": []
  },
  {
    "name": "amendment",
    "label": "Phụ lục hợp đồng",
    "fields": [
      {
        "name": "contract",
        "type": "ref",
        "required": true,
        "ref": "contract.contract"
      },
      {
        "name": "reference",
        "type": "string",
        "required": false
      },
      {
        "name": "effective_date",
        "type": "date",
        "required": true
      },
      {
        "name": "reason",
        "type": "text",
        "required": true
      },
      {
        "name": "changes",
        "type": "json",
        "required": true
      },
      {
        "name": "status",
        "type": "enum",
        "required": false,
        "options": [
          "draft",
          "submitted",
          "approved",
          "applied",
          "rejected",
          "effective",
          "cancelled"
        ]
      }
    ],
    "states": {
      "field": "status",
      "initial": "draft",
      "actions": {
        "submitted": {
          "from": [
            "draft",
            "rejected"
          ],
          "to": "submitted"
        },
        "approved": {
          "from": [
            "submitted"
          ],
          "to": "approved"
        },
        "rejected": {
          "from": [
            "submitted"
          ],
          "to": "rejected"
        },
        "applied": {
          "from": [
            "approved"
          ],
          "to": "applied"
        },
        "cancelled": {
          "from": [
            "draft",
            "rejected",
            "submitted",
            "approved"
          ],
          "to": "cancelled"
        }
      }
    },
    "computed": {},
    "constraints": []
  }
 ],
 "rules": [],
 "seeds": [],
 "publishes": [],
 "jobs": []
}
