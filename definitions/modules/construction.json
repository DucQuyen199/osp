{
  "id": "construction",
  "name": "Xây dựng",
  "description": "Dự toán, công trường, thầu phụ, nghiệm thu khối lượng và cam kết chi phí.",
  "category": "industry",
  "version": "0.1.0",
  "depends": [
    "project",
    "accounting",
    "purchasing"
  ],
  "core": false,
  "entities": [
    {
      "name": "boq",
      "label": "Dự toán (BOQ)",
      "fields": [
        {
          "name": "project",
          "type": "ref",
          "required": true,
          "ref": "project.project"
        },
        {
          "name": "number",
          "type": "string",
          "required": false,
          "system": true
        },
        {
          "name": "revision",
          "type": "number",
          "required": false,
          "system": true
        },
        {
          "name": "supersedes",
          "type": "ref",
          "required": false,
          "ref": "construction.boq"
        },
        {
          "name": "revision_reason",
          "type": "text",
          "required": false
        },
        {
          "name": "items",
          "type": "json",
          "required": false
        },
        {
          "name": "total",
          "type": "money",
          "required": false
        },
        {
          "name": "status",
          "type": "enum",
          "required": false,
          "options": ["draft", "approved", "superseded"]
        }
      ],
      "states": {
        "field": "status",
        "initial": "draft",
        "actions": {
          "approved": { "from": ["draft"], "to": "approved" },
          "superseded": { "from": ["approved"], "to": "superseded" }
        }
      },
      "computed": {},
      "constraints": []
    },
    {
      "name": "material_request",
      "label": "Yêu cầu mua vật tư theo BOQ",
      "fields": [
        { "name": "boq", "type": "ref", "required": true, "ref": "construction.boq" },
        { "name": "warehouse", "type": "ref", "required": true, "ref": "inventory.warehouse" },
        { "name": "sourcing_method", "type": "enum", "required": true, "options": ["direct", "competitive"] },
        { "name": "supplier", "type": "ref", "required": false, "ref": "master-data.party" },
        { "name": "requested_by", "type": "string", "required": false },
        { "name": "reason", "type": "text", "required": false },
        { "name": "purchase_requisition", "type": "ref", "required": false, "ref": "purchasing.purchase_requisition", "system": true }
      ],
      "states": null,
      "computed": {},
      "constraints": []
    },
    {
      "name": "site",
      "label": "Công trường",
      "fields": [
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "project",
          "type": "ref",
          "required": false,
          "ref": "project.project"
        },
        {
          "name": "address",
          "type": "string",
          "required": false
        }
      ],
      "states": null,
      "computed": {},
      "constraints": []
    },
    {
      "name": "subcontract",
      "label": "Thầu phụ",
      "fields": [
        {
          "name": "project",
          "type": "ref",
          "required": true,
          "ref": "project.project"
        },
        {
          "name": "vendor",
          "type": "ref",
          "required": true,
          "ref": "master-data.party"
        },
        {
          "name": "value",
          "type": "money",
          "required": true
        },
        {
          "name": "scope",
          "type": "text",
          "required": false
        },
        {
          "name": "status",
          "type": "enum",
          "required": false,
          "options": [
            "draft",
            "signed",
            "completed"
          ]
        }
      ],
      "states": {
        "field": "status",
        "initial": "draft",
        "actions": {
          "signed": {
            "from": [
              "draft"
            ],
            "to": "signed"
          },
          "completed": {
            "from": [
              "signed"
            ],
            "to": "completed"
          }
        }
      },
      "computed": {},
      "constraints": []
    },
    {
      "name": "site_diary",
      "label": "Nhật ký thi công",
      "fields": [
        {
          "name": "site",
          "type": "ref",
          "required": true,
          "ref": "construction.site"
        },
        {
          "name": "date",
          "type": "date",
          "required": true
        },
        {
          "name": "weather",
          "type": "string",
          "required": false
        },
        {
          "name": "notes",
          "type": "text",
          "required": false
        }
      ],
      "states": null,
      "computed": {},
      "constraints": []
    },
    {
      "name": "progress_claim",
      "label": "Nghiệm thu / đề nghị thanh toán thầu phụ",
      "fields": [
        { "name": "subcontract", "type": "ref", "required": true, "ref": "construction.subcontract" },
        { "name": "vendor", "type": "ref", "required": true, "ref": "master-data.party" },
        { "name": "period", "type": "date", "required": true },
        { "name": "amount", "type": "money", "required": true },
        { "name": "notes", "type": "text", "required": false },
        { "name": "status", "type": "enum", "required": false, "options": ["draft", "approved"] }
      ],
      "states": {
        "field": "status",
        "initial": "draft",
        "actions": { "approved": { "from": ["draft"], "to": "approved" } }
      },
      "computed": {},
      "constraints": []
    }
  ],
  "rules": [],
  "seeds": [],
  "publishes": [],
  "jobs": []
}
