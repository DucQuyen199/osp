],
 "terminology": {
  "master-data.party": "Khách hàng vay/Người mua BH",
  "master-data.product": "Sản phẩm tài chính",
  "crm.deal": "Hồ sơ vay/BH"
 },
 "customFields": {
  "master-data.party": [
   {
    "name": "national_id",
    "type": "string",
    "required": false
   },
   {
    "name": "monthly_income",
    "type": "money",
    "required": false
   },
   {
    "name": "credit_score",
    "type": "number",
    "required": false
   }
  ]
 },
 "roles": {
  "loan_officer": {
    "name": "Cán bộ tín dụng / Thu nợ",
    "permissions": [
      "lending.loan.read",
      "lending.loan.create",
      "lending.loan.update",
      "lending.loan.delete",
      "lending.repayment.*",
      "crm.*",
      "document.*",
      "master-data.party.read"
    ]
  },
  "underwriter": {
    "name": "Thẩm định",
    "permissions": [
      "lending.loan.read",
      "lending.loan.approved",
      "lending.loan.rejected",
      "insurance.policy.read",
      "insurance.claim.read",
      "insurance.claim.update",
      "insurance.claim.approved",
      "insurance.claim.rejected",
      "workflow-approval.*",
      "master-data.party.read"
    ]
  },
  "disbursement_officer": {
    "name": "Giải ngân / Chi trả",
    "permissions": [
      "lending.loan.read",
      "lending.loan.disbursed",
      "lending.loan.closed",
      "lending.loan.defaulted",
      "lending.repayment.read",
      "insurance.policy.read",
      "insurance.claim.read",
      "insurance.claim.update",
      "insurance.claim.paid",
      "accounting.account.read",
      "master-data.party.read"
    ]
  },
  "insurance_agent": {
    "name": "Tư vấn bảo hiểm",
    "permissions": [
      "insurance.policy.create",
      "insurance.policy.read",
      "insurance.policy.update",
      "insurance.policy.activated",
      "insurance.policy.cancelled",
      "insurance.claim.read",
      "insurance.claim.create",
      "accounting.invoice.read",
      "master-data.party.read"
    ]
  },
  "recruiter": {
    "name": "Chuy?n vi?n tuy?n d?ng",
    "permissions": [
      "recruitment.job_opening.read",
      "recruitment.job_opening.create",
      "recruitment.job_opening.update",
      "recruitment.job_opening.closed",
      "recruitment.candidate.read",
      "recruitment.candidate.create",
      "recruitment.candidate.update",
      "recruitment.application.read",
      "recruitment.application.create",
      "recruitment.application.update",
      "recruitment.application.applied",
      "recruitment.application.rejected",
      "hrm.department.read",
      "hrm.position.read"
    ]
  },
  "hiring_manager": {
    "name": "Qu?n l? tuy?n d?ng",
    "permissions": [
      "recruitment.job_opening.read",
      "recruitment.job_opening.create",
      "recruitment.job_opening.update",
      "recruitment.job_opening.closed",
      "recruitment.candidate.read",
      "recruitment.candidate.create",
      "recruitment.candidate.update",
      "recruitment.application.read",
      "recruitment.application.create",
      "recruitment.application.update",
      "recruitment.application.applied",
      "recruitment.application.hired",
      "recruitment.application.rejected",
      "hrm.department.read",
      "hrm.position.read"
    ]
  }
},
