{
 "id": "finance",
 "name": "Tài chính - Bảo hiểm",
 "description": "Công ty tài chính tiêu dùng, tín dụng vi mô, đại lý bảo hiểm.",
 "modules": [
  "lending",
  "insurance",
  "crm",
  "contract",
  "document",
  "workflow-approval",
  "communication",
  "accounting",
  "einvoice",
  "hrm",
  "payroll",
  "bi"
 ],
 "terminology": {
  "master-data.party": "Khách hàng vay/Người mua BH",
  "master-data.product": "Sản phẩm tài chính",
  "crm.deal": "Hồ sơ vay/BH"
 },
 "customFields": {
  "master-data.party": [
   {
    "name": "national_id",
    "type": "string",
    "required": false
   },
   {
    "name": "monthly_income",
    "type": "money",
    "required": false
   },
   {
    "name": "credit_score",
    "type": "number",
    "required": false
   }
  ]
 },
 "roles": {
  "loan_officer": {
   "name": "Cán bộ tín dụng / Thu nợ",
   "permissions": [
    "lending.loan.read",
    "lending.loan.create",
    "lending.loan.update",
    "lending.loan.delete",
    "lending.repayment.*",
    "crm.*",
    "document.*",
    "master-data.party.read"
   ]
  },
  "underwriter": {
   "name": "Thẩm định",
   "permissions": [
    "lending.loan.read",
    "lending.loan.approved",
    "lending.loan.rejected",
    "insurance.policy.read",
    "insurance.claim.read",
    "insurance.claim.update",
    "insurance.claim.approved",
    "insurance.claim.rejected",
    "workflow-approval.*",
    "master-data.party.read"
   ]
  },
  "disbursement_officer": {
   "name": "Giải ngân / Chi trả",
   "permissions": [
    "lending.loan.read",
    "lending.loan.disbursed",
    "lending.loan.closed",
    "lending.loan.defaulted",
    "lending.repayment.read",
    "insurance.policy.read",
    "insurance.claim.read",
    "insurance.claim.update",
    "insurance.claim.paid",
    "accounting.account.read",
    "master-data.party.read"
   ]
  },
  "insurance_agent": {
   "name": "Tư vấn bảo hiểm",
   "permissions": [
    "insurance.policy.create",
    "insurance.policy.read",
    "insurance.policy.update",
    "insurance.policy.activated",
    "insurance.policy.cancelled",
    "insurance.claim.read",
    "insurance.claim.create",
    "accounting.invoice.read",
    "master-data.party.read"
   ]
  }
 },
 "kpis": [
  "Dư nợ",
  "Tỷ lệ nợ xấu (NPL)",
  "Tỷ lệ phê duyệt",
  "Tỷ lệ bồi thường"
 ]
}
