# Copy to .env and replace both placeholders with 64-character hex secrets.
# Generate each value with: openssl rand -hex 32
OSP_DB_NAME=osp
OSP_DB_USER=osp_app
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-openssl-rand-hex-32
OSP_DB_PASSWORD=replace-with-a-different-openssl-rand-hex-32

# The app listens only on localhost; terminate HTTPS at your reverse proxy.
OSP_BIND_ADDRESS=127.0.0.1
OSP_PORT=3000
OSP_DEMO=0
OSP_SIGNUP=1
OSP_PUBLIC_URL=https://erp.example.com
OSP_OUTBOX_INTERVAL_SEC=2
OSP_COMM_INTERVAL_SEC=5
# Optional HTTPS endpoints implementing OSP's notification JSON contract.
# Leave unset to retain messages in the queue without sending.
OSP_COMM_EMAIL_ENDPOINT=
OSP_COMM_EMAIL_TOKEN=
OSP_COMM_EMAIL_FROM=
# SMTP is an alternative email transport; only implicit TLS or required STARTTLS is allowed.
OSP_COMM_SMTP_HOST=
OSP_COMM_SMTP_PORT=
OSP_COMM_SMTP_MODE=implicit_tls
OSP_COMM_SMTP_USERNAME=
OSP_COMM_SMTP_PASSWORD=
OSP_COMM_SMS_ENDPOINT=
OSP_COMM_SMS_TOKEN=
OSP_COMM_SMS_FROM=
