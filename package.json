{
  "name": "osp-suite",
  "private": true,
  "version": "0.2.0",
  "description": "OSP Suite - bộ phần mềm quản trị doanh nghiệp dạng module, đa ngành, đa tenant",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "modules/*",
    "verticals/*"
  ],
  "scripts": {
    "dev": "node tools/dev.mjs",
    "start": "npm run build && node tools/run-rust.mjs --release",
    "predev": "node tools/sync-client-assets.mjs",
    "prebuild": "node tools/sync-client-assets.mjs",
    "build": "vite --config client/vite.config.js build",
    "test": "cargo test --manifest-path server/Cargo.toml",
    "test:container": "node tools/verify-container.mjs",
    "test:backup-crypto": "node --test tools/backup-crypto.test.mjs",
    "test:decimal": "node --test tools/decimal.test.mjs",
    "test:accounting-refunds": "node --test tools/adjustment-refunds.test.mjs",
    "e2e": "npm run build && node tests/e2e/ui.mjs",
    "lint": "cargo run --manifest-path server/Cargo.toml --bin catalog -- lint",
    "lint:translations": "node tools/check-ui-translations.mjs",
    "docs": "cargo run --manifest-path server/Cargo.toml --bin catalog -- docs",
    "new:module": "cargo run --manifest-path server/Cargo.toml --bin catalog -- new",
    "check": "node tools/check-no-typescript.mjs && node tools/check-ui-csp.mjs && node tools/check-ui-translations.mjs && cargo fmt --manifest-path server/Cargo.toml -- --check && cargo check --manifest-path server/Cargo.toml --no-default-features --all-targets && npm run lint && npm run build",
    "backup": "node tools/backup.mjs",
    "check:ui-csp": "node tools/check-ui-csp.mjs",
    "export:defs": "cargo run --manifest-path server/Cargo.toml --bin catalog -- export"
  },
  "devDependencies": {
    "axe-core": "4.10.2",
    "puppeteer-core": "^25.17.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
